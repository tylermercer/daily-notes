{
  "name": "daily-notes",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler dev --port 4321",
    "astro": "astro",
    "encrypt": "staticrypt ./dist/client/ -r --template-color-primary \"#0c5959\"  --template-color-secondary \"#0c5959\" --template-title \"Daily Notes\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@fontsource-variable/dm-sans": "^5.1.1",
    "@fontsource-variable/newsreader": "^5.1.0",
    "astro": "7.4.13",
    "astro-svg-loaders": "^5.0.0",
    "color-contrast-finder": "^1.0.2",
    "modern-normalize": "^3.0.1",
    "unsplash-js": "^7.0.19"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "patch-package": "^8.0.0",
    "sass-embedded": "^1.82.0",
    "sharp": "^0.34.5",
    "staticrypt": "^3.5.0",
    "tsx": "^4.20.6",
    "wrangler": "^4.165.0"
  },
