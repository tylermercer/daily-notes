lug":"ocean-under-blue-sky-m5gYCrcwUgQ","alternative_slugs":{"en":"ocean-under-blue-sky-m5gYCrcwUgQ","es":"oceano-bajo-el-cielo-azul-m5gYCrcwUgQ","ja":"青空の下の海-m5gYCrcwUgQ","fr":"ocean-sous-ciel-bleu-m5gYCrcwUgQ","it":"oceano-sotto-il-cielo-blu-m5gYCrcwUgQ","ko":"푸른-하늘-아래-바다-m5gYCrcwUgQ","de":"ozean-unter-blauem-himmel-m5gYCrcwUgQ","pt":"oceano-sob-o-ceu-azul-m5gYCrcwUgQ","id":"lautan-di-bawah-langit-biru-m5gYCrcwUgQ"},"created_at":"2018-11-17T15:10:43Z","updated_at":"2026-02-18T06:28:49Z","promoted_at":null,"width":5184,"height":3456,"color":"#262626","blur_hash":"LVG8Wf=|bIof?wt7oLof1hR+n%j[","description":"I have always been a fan of the skies. I cannot go by a daw without taking a picture of the sky. Especially when it looks like this, looks so beautiful. The process wasn’t so complicated, I was just standing as still as I could while taking the shot because I boosted my aperture to 10 because I didn’t want any sort of blurring. Well this picture is very special to me because, Srilanka was such a beautiful country, the people are absolutely different, kind and they all make you feel like you’re home. This picture takes me back to the people I met there, and the time I spent. Just makes me happy","alt_description":"ocean under blue sky","breadcrumbs":[],"urls":{"raw":"https://images.unsplash.com/photo-1542467372-47ff6783af3d?ixlib=rb-4.1.0","full":"https://images.unsplash.com/photo-1542467372-47ff6783af3d?ixlib=rb-4.1.0&q=85&fm=jpg&crop=entropy&cs=srgb","regular":"https://images.unsplash.com/photo-1542467372-47ff6783af3d?ixlib=rb-4.1.0&q=80&fm=jpg&crop=entropy&cs=tinysrgb&w=1080&fit=max","small":"https://images.unsplash.com/photo-1542467372-47ff6783af3d?ixlib=rb-4.1.0&q=80&fm=jpg&crop=entropy&cs=tinysrgb&w=400&fit=max","thumb":"https://images.unsplash.com/photo-1542467372-47ff6783af3d?ixlib=rb-4.1.0&q=80&fm=jpg&crop=entropy&cs=tinysrgb&w=200&fit=max","small_s3":"https://s3.us-west-2.amazonaws.com/images.unsplash.com/small/photo-1542467372-47ff6783af3d"},"links":{"